          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 0,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "vigil.statements.orphaned",
                              "temporality": "unspecified",
                              "timeAggregation": "latest",
                              "spaceAggregation": "sum",
                              "reduceTo": ""
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "groupBy": [],
                          "order": null,
                          "selectFields": null,
                          "secondaryAggregations": null,
                          "functions": null,
                          "legend": "orphaned"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "stepInterval": 0,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "vigil.statements.tracked",
                              "temporality": "unspecified",
                              "timeAggregation": "latest",
                              "spaceAggregation": "sum",
                              "reduceTo": ""
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "groupBy": [],
                          "order": null,
                          "selectFields": null,
                          "secondaryAggregations": null,
                          "functions": null,
                          "legend": "tracked (monitored db)"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
