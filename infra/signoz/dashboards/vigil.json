{
  "schemaVersion": "v6",
  "generateName": true,
  "tags": [
    {
      "key": "project",
      "value": "vigil"
    },
    {
      "key": "db",
      "value": "postgres"
    }
  ],
  "spec": {
    "display": {
      "name": "Vigil",
      "description": "Vigil's own telemetry: what the collector detects, how healthy its polling is, and whether brain's fixes actually helped. Provisioned via the API from infra/signoz/dashboards/vigil.json."
    },
    "variables": [],
    "panels": {
      "conn_utilization": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Connection utilization",
            "description": "Open client connections / max_connections. The 'Postgres approaching max_connections' alert fires above 80% for 1 minute."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "1"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 1,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "vigil.connections.utilization",
                        "temporality": "unspecified",
                        "timeAggregation": "latest",
                        "spaceAggregation": "max"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": ""
                    },
                    "groupBy": [],
                    "legend": "utilization"
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "findings_by_rule": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Findings by rule",
            "description": "vigil.findings.detected (collector), increase per step, stacked by vigil.rule."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false,
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "vigil.findings.detected",
                        "temporality": "cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": ""
                    },
                    "groupBy": [
                      {
                        "name": "vigil.rule",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": "{{vigil.rule}}"
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "fix_before_after": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Fix latency: before vs after (ms)",
            "description": "From brain's verify_fix spans (vigil.before_ms / vigil.after_ms), averaged per rule over the time range. Spans, not a metric: per-finding values with no cardinality cost."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": null,
                "decimalPrecision": "3"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "aggregations": [
                      {
                        "expression": "avg(vigil.before_ms)",
                        "alias": "before_ms"
                      },
                      {
                        "expression": "avg(vigil.after_ms)",
                        "alias": "after_ms"
                      },
                      {
                        "expression": "count()",
                        "alias": "verified_fixes"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "name = 'verify_fix' AND vigil.before_ms EXISTS"
                    },
                    "groupBy": [
                      {
                        "name": "vigil.rule",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "fix_verdicts": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Fix verdicts by rule",
            "description": "vigil.fixes.verified (brain): how each rule's findings ended up."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": null,
                "decimalPrecision": "2"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "vigil.fixes.verified",
                        "temporality": "delta",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": ""
                    },
                    "groupBy": [
                      {
                        "name": "vigil.rule",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "vigil.verdict",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": ""
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "poll_duration": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Poll cycle duration (p50 / p95)",
            "description": "vigil.poll.duration histogram. Percentiles are interpolated within buckets (0.1/0.25/0.5s...), so they are estimates -- exact per-cycle durations are on the vigil.poll_cycle traces."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "s",
                "decimalPrecision": "3"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 0,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "vigil.poll.duration.bucket",
                              "temporality": "cumulative",
                              "timeAggregation": "rate",
                              "spaceAggregation": "p50",
                              "reduceTo": ""
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "groupBy": [],
                          "order": null,
                          "selectFields": null,
                          "secondaryAggregations": null,
                          "functions": null,
                          "legend": "p50"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "stepInterval": 0,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "vigil.poll.duration.bucket",
                              "temporality": "cumulative",
                              "timeAggregation": "rate",
                              "spaceAggregation": "p95",
                              "reduceTo": ""
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "groupBy": [],
                          "order": null,
                          "selectFields": null,
                          "secondaryAggregations": null,
                          "functions": null,
                          "legend": "p95"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "poll_errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Poll errors by source",
            "description": "vigil.poll.errors (collector), by Postgres stats view. Empty is the healthy state: a counter series only exists after its first increment, so 'No data' means no poll has ever failed."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false,
                "stackedBarChart": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "vigil.poll.errors",
                        "temporality": "cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": ""
                    },
                    "groupBy": [
                      {
                        "name": "vigil.source",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": "{{vigil.source}}"
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "rewrite_outcomes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "LLM rewrite outcomes",
            "description": "Every nested_subquery finding brain handled, by vigil.verdict."
          },
          "plugin": {
            "kind": "signoz/PieChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "vigil.fixes.verified",
                        "temporality": "delta",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "vigil.rule = 'nested_subquery'"
                    },
                    "groupBy": [
                      {
                        "name": "vigil.verdict",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": "{{vigil.verdict}}"
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "rewrite_rejected_share": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "LLM rewrites rejected",
            "description": "Share of LLM-proposed rewrites (nested_subquery) that failed the EXCEPT equivalence check: rejected / (rejected + helped + not_helped). 'unavailable' (LLM returned nothing usable) is excluded -- there was no rewrite to reject."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "percent",
                "decimalPrecision": "0"
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 0,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "vigil.fixes.verified",
                              "temporality": "delta",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "vigil.rule = 'nested_subquery' AND vigil.verdict = 'rejected'"
                          },
                          "groupBy": [],
                          "order": null,
                          "selectFields": null,
                          "secondaryAggregations": null,
                          "functions": null,
                          "legend": ""
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "stepInterval": 0,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "vigil.fixes.verified",
                              "temporality": "delta",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "vigil.rule = 'nested_subquery' AND vigil.verdict IN ('rejected', 'helped', 'not_helped')"
                          },
                          "groupBy": [],
                          "order": null,
                          "selectFields": null,
                          "secondaryAggregations": null,
                          "functions": null,
                          "legend": ""
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "A / B * 100",
                          "disabled": false,
                          "order": null,
                          "functions": null,
                          "legend": "rejected %"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "statements": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "pg_stat_statements: tracked vs orphaned",
            "description": "Orphaned = entries whose database no longer exists (e.g. dropped sandbox clones). They still count toward pg_stat_statements.max and can evict real entries. Each brain run adds more: its sandbox clones are created, benchmarked and dropped."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
